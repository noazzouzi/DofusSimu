{
  "name": "dofussimu",
  "version": "0.0.1",
  "private": true,
  "description": "Simulateur de combats et d'équipements Dofus (moteur de combat, IA, optimiseur de stuff et de composition, replays animés)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "fetch:data": "NODE_USE_ENV_PROXY=1 node scripts/fetch-dofusdb.mjs",
    "sim": "tsx src/cli/simulate.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.7"
  }
}
