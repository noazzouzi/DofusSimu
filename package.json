{
  "name": "dofussimu",
  "version": "0.0.1",
  "private": true,
  "description": "Simulateur de combats et d'équipements Dofus (moteur de combat, IA, optimiseur de stuff et de composition, replays animés)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "fetch:data": "NODE_USE_ENV_PROXY=1 node scripts/fetch-dofusdb.mjs",
    "sim": "tsx src/cli/simulate.ts",
    "reine:serveur": "tsx tools/reine-des-voleurs/planificateur/serveur.ts",
    "reine:ia": "tsx tools/fightlog/ia.ts",
    "reine:combat": "tsx tools/fightlog/combat.ts",
    "reine:algorithme": "tsx tools/fightlog/combat.ts --sans-scenarios",
    "reine:scenarios": "tsx tools/reine-des-voleurs/scenarios/index.ts",
    "baleine:bilan": "tsx tools/ventre-de-la-baleine/bilan.ts",
    "baleine:menaces": "tsx tools/ventre-de-la-baleine/menaces.ts",
    "baleine:serveur": "tsx tools/ventre-de-la-baleine/serveur.ts",
    "baleine:script": "tsx tools/ventre-de-la-baleine/script.ts",
    "baleine:rejouer": "tsx tools/ventre-de-la-baleine/rejouer.ts",
    "feca:serveur": "tsx tools/feca/serveur.ts",
    "feca:script": "tsx tools/feca/script.ts",
    "feca:main": "tsx tools/feca/script.ts --main Kaskyzo",
    "feca:rejouer": "tsx tools/feca/rejouer.ts",
    "feca:tours": "tsx tools/feca/tours.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.7"
  }
}
